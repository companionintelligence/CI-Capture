# Keep the build context small. The build needs src/, vizier/, Cargo.*,
# build.rs (none yet), packaging/icons/icon.png (embedded tray icon),
# and not much else.
target
**/target
.git
.github
.claude
docs
packaging/**
!packaging/icons/
!packaging/icons/icon.png
*.md
!Cargo.toml
node_modules
*.png
!packaging/icons/icon.png
*.zip
*.tar.gz
CI-Applet.app
